<Application x:Class="PanelSOS.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>

    <!-- Mismos colores que el portal web: quien opera ve un solo sistema -->
    <SolidColorBrush x:Key="Fondo"      Color="#0D1117"/>
    <SolidColorBrush x:Key="Superficie" Color="#161B22"/>
    <SolidColorBrush x:Key="Superficie2" Color="#21262D"/>
    <SolidColorBrush x:Key="Borde"      Color="#30363D"/>
    <SolidColorBrush x:Key="Texto"      Color="#F0F6FC"/>
    <SolidColorBrush x:Key="TextoSuave" Color="#9198A1"/>
    <SolidColorBrush x:Key="Acento"     Color="#F78166"/>
    <SolidColorBrush x:Key="Ok"         Color="#3FB950"/>
    <SolidColorBrush x:Key="Alerta"     Color="#D29922"/>
    <SolidColorBrush x:Key="Critico"    Color="#F85149"/>
    <SolidColorBrush x:Key="Info"       Color="#58A6FF"/>

    <!-- OJO: nada de fijar Foreground aqui. Un Setter en un estilo implicito
         gana a la herencia, asi que el texto de CUALQUIER boton se pintaria de
         este color y se perderia el contraste del boton principal. El color
         base se hereda desde la ventana. -->
    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>

    <!-- Boton base. Alto generoso: esto se usa con prisa. -->
    <Style x:Key="BotonBase" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Texto}"/>
      <Setter Property="Background" Value="{StaticResource Superficie2}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Borde}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,9"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="borde" CornerRadius="6"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="borde" Property="Background" Value="#2D333B"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="BotonPrincipal" TargetType="Button" BasedOn="{StaticResource BotonBase}">
      <Setter Property="Background" Value="{StaticResource Acento}"/>
      <Setter Property="Foreground" Value="#1A1005"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>

    <Style x:Key="BotonPeligro" TargetType="Button" BasedOn="{StaticResource BotonBase}">
      <Setter Property="Foreground" Value="#FFB4AB"/>
      <Setter Property="Background" Value="#2D1214"/>
    </Style>

    <!-- Pestanas de la zona principal. Se pintan a mano, y no con ToggleButton,
         por la misma razon que el desplegable de mas abajo: los controles con
         estado de Windows se dibujan con los colores del SISTEMA y con tema
         oscuro quedan ilegibles. El code-behind mueve Tag entre "activa" y
         vacio, y el disparador hace el resto. -->
    <Style x:Key="Pestana" TargetType="Button" BasedOn="{StaticResource BotonBase}">
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource TextoSuave}"/>
      <Style.Triggers>
        <Trigger Property="Tag" Value="activa">
          <Setter Property="Background" Value="{StaticResource Superficie2}"/>
          <Setter Property="BorderBrush" Value="{StaticResource Borde}"/>
          <Setter Property="Foreground" Value="{StaticResource Texto}"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- Leds de estado. El color lo pone el code-behind; aqui solo la forma y
         el halo, que es lo que los hace legibles de lejos sobre fondo oscuro. -->
    <Style x:Key="Led" TargetType="Ellipse">
      <Setter Property="Width" Value="11"/>
      <Setter Property="Height" Value="11"/>
      <Setter Property="Margin" Value="0,0,7,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Fill" Value="#484F58"/>
      <Setter Property="Stroke" Value="#20000000"/>
      <Setter Property="StrokeThickness" Value="1"/>
    </Style>

    <Style x:Key="EtiquetaLed" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource TextoSuave}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="Titulo" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextoSuave}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Margin" Value="2,10,0,6"/>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource Superficie2}"/>
      <Setter Property="Foreground" Value="{StaticResource Texto}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Borde}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="7,6"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="CaretBrush" Value="{StaticResource Texto}"/>
    </Style>

    <!--
      Plantilla COMPLETA del desplegable, cerrado y abierto.
      La plantilla de Windows pinta el control con los colores del SISTEMA, no
      con los del control: con tema claro se veia bien y con tema oscuro el
      texto quedaba ilegible. Redefinir las claves del sistema arreglaba la
      lista abierta pero no la cerrada. Con plantilla propia no queda nada
      dependiendo del tema que tenga el equipo.
    -->
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="{StaticResource Superficie2}"/>
      <Setter Property="Foreground" Value="{StaticResource Texto}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Borde}"/>
      <Setter Property="Padding" Value="9,7"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="alternar" Focusable="False" ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                        RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="marco" CornerRadius="6"
                            Background="{StaticResource Superficie2}"
                            BorderBrush="{StaticResource Borde}" BorderThickness="1">
                      <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,11,0" Data="M 0 0 L 9 0 L 4.5 5 Z"
                            Fill="{StaticResource TextoSuave}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="marco" Property="BorderBrush"
                                Value="{StaticResource Info}"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>

              <!-- Esto es lo que arregla el texto con la lista CERRADA: forzar
                   el color en el presentador del elemento seleccionado. -->
              <ContentPresenter IsHitTestVisible="False"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                Margin="{TemplateBinding Padding}"
                                VerticalAlignment="Center" HorizontalAlignment="Left"
                                TextElement.Foreground="{StaticResource Texto}"/>

              <Popup x:Name="desplegable" Placement="Bottom" AllowsTransparency="True"
                     IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False"
                     PopupAnimation="Slide" VerticalOffset="2">
                <Border CornerRadius="6" Margin="0,0,6,6"
                        Background="{StaticResource Superficie2}"
                        BorderBrush="{StaticResource Borde}" BorderThickness="1"
                        MinWidth="{Binding ActualWidth,
                                   RelativeSource={RelativeSource TemplatedParent}}"
                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                  <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.6" Color="Black"/>
                  </Border.Effect>
                  <ScrollViewer>
                    <ItemsPresenter/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Plantilla propia para cada renglon: asi el color no depende de lo que
         herede de la plantilla del sistema. -->
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{StaticResource Texto}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="9,7"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="fondo" Background="{TemplateBinding Background}"
                    Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <!-- Azul con el texto claro que ya se hereda: si pusieramos el
                   naranja de acento habria que oscurecer el texto, y eso choca
                   con el color heredado. -->
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="fondo" Property="Background" Value="#1F6FEB"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="fondo" Property="Background" Value="#30363D"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

  </Application.Resources>
</Application>
