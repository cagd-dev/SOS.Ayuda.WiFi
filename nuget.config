<?xml version="1.0" encoding="utf-8"?>
<!--
  El panel de mando necesita un paquete de NuGet (WebView2) y no todas las
  maquinas traen nuget.org configurado: en un equipo con Visual Studio recien
  instalado solo esta el origen offline, y la compilacion falla con NU1101.

  Se declara aqui, en el repositorio, en vez de tocar la configuracion global
  de quien compila: asi el proyecto se construye igual en cualquier maquina.
  No lleva <clear/> a proposito, para no pisar los origenes que ya tenga
  configurados quien lo use (mirrors internos, cache offline).
-->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
